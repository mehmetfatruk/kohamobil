# Yerel geliştirme için örnek. `.env` olarak kopyalayın; `.env` dosyası ASLA commit edilmez.
# Üretimde secret'lar *_FILE değişkenleriyle Docker secret dosyalarından okunur (docs/DEPLOYMENT.md §8).
NODE_ENV=development
DEPLOYMENT_MODE=CENTRAL
PORT=3000
LOG_LEVEL=debug
PUBLIC_API_URL=https://api.koha-tr.com

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mirakil
DATABASE_USER=mirakil
# Yerelde: infra/docker/.secrets/postgres_password dosyasını gösterin (scripts/generate-secrets.sh üretir)
DATABASE_PASSWORD_FILE=../../infra/docker/.secrets/postgres_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD_FILE=../../infra/docker/.secrets/redis_password
