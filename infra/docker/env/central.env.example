# CENTRAL kurulum örneği. Sunucuda `central.env` olarak kopyalayın (repoya EKLEMEYİN).
# Secret DEĞERLERİ bu dosyaya yazılmaz; SECRETS_DIR altındaki dosyalardan okunur.
#
#   docker compose -f compose.base.yml --env-file env/central.env up -d

NODE_ENV=production
DEPLOYMENT_MODE=CENTRAL
LOG_LEVEL=info

PUBLIC_API_URL=https://api.koha-tr.com
API_HOST=api.koha-tr.com
DIRECTORY_HOST=directory.koha-tr.com
ADMIN_HOST=admin.koha-tr.com
APP_HOST=app.koha-tr.com
ACME_EMAIL=CHANGE_ME@ornek.com.tr

# scripts/generate-secrets.sh /etc/mirakil/secrets ile üretilen dizin
SECRETS_DIR=/etc/mirakil/secrets

POSTGRES_DB=mirakil
POSTGRES_USER=mirakil

# Pilot sunucu (4 vCPU / 8 GB) bellek sınırları — docs/DEPLOYMENT.md §3.1
POSTGRES_MEM_LIMIT=2g
REDIS_MEM_LIMIT=512m
REDIS_MAXMEMORY=384mb
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=512m

REGISTRY=mirakil
API_VERSION=0.1.0
ADMIN_VERSION=0.1.0
