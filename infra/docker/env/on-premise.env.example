# ON_PREMISE kurulum örneği (sonraki faz). Kurumun sunucusunda `on-premise.env` olarak kopyalayın.
NODE_ENV=production
DEPLOYMENT_MODE=ON_PREMISE
LOG_LEVEL=info

PUBLIC_API_URL=https://kutuphane-api.CHANGE_ME.edu.tr
