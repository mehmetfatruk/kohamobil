{
  "name": "@mirakil/koha-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Koha entegrasyon katmanı: yetenek tespiti, uyumluluk (strateji) çözümleme, adapter arayüzü. Yalnızca Gateway (apps/api) kullanır.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@mirakil/types": "workspace:*"
  },
  "devDependencies": {
    "@mirakil/config": "workspace:*",
    "eslint": "^9.39.5",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15",
    "@types/node": "^22.20.5"
  }
}
